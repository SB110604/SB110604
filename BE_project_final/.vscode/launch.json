{
  "version": "0.2.0",
  "configurations": [
    {
      // ── Run & Debug FastAPI with uvicorn (F5) ──────────────────────────
      "name": "🚀 Run FastAPI (uvicorn --reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host", "0.0.0.0",
        "--port", "8000"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "jinja": true,
      "justMyCode": false,
      "console": "integratedTerminal",
      // Breakpoints work inside FastAPI route handlers
      "subProcess": true
    },
    {
      // ── Run pytest (Ctrl+Shift+D → select this) ───────────────────────
      "name": "🧪 Run pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-v"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
