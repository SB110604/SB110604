{
  "version": "2.0.0",
  "tasks": [
    {
      // ── STEP 1: First-time setup ────────────────────────────────────────
      // Terminal → Run Task → "⚙️ Setup Project (first time)"
      "label": "⚙️ Setup Project (first time)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["setup.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      // ── STEP 2: Start server ────────────────────────────────────────────
      // Terminal → Run Build Task (Ctrl+Shift+B) to start the server
      "label": "🚀 Start Server (python run.py)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["run.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": { "regexp": "." },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Starting",
            "endsPattern": "Application startup complete"
          }
        }
      ]
    },
    {
      // ── Run tests ───────────────────────────────────────────────────────
      "label": "🧪 Run Tests (pytest)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest", "tests/", "-v"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      // ── Install / refresh deps ───────────────────────────────────────────
      "label": "📦 Install Dependencies",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pip", "install", "-r", "requirements.txt"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new" },
      "problemMatcher": []
    }
  ]
}
