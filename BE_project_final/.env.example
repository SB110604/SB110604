# ============================================================
# BE Project Final — Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control.
# ============================================================

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=your_super_secret_key_here
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=industrial_safety_db

# --- Twilio SMS ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX       # Your Twilio phone number
ALERT_TO_NUMBER=+919322511660         # Primary alert recipient

# --- AI / ML ---
ANOMALY_THRESHOLD=0.85
AI_MODEL_PATH=app/models/safety_model.pkl

# --- JWT Auth ---
JWT_SECRET_KEY=your_jwt_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Email (optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
